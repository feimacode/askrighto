{"data":{"productId":"LN001MBLSTD001","lastUpdated":"2026-11-05T00:01:00.001Z","productCategory":"RESIDENTIAL_MORTGAGES","name":"Macquarie Offset Home Loan","description":"The Macquarie offset home loan package is designed to reduce your interest repayments, bucket your savings and access your savings without additional fees.","brand":"Macquarie Bank Limited","isTailored":false,"additionalInformation":{"bundleUri":"https://www.macquarie.com.au/home-loans/home-loan-package.html","eligibilityUri":"https://www.macquarie.com.au/home-loans/offset-home-loan.html#how-to-apply","feesAndPricingUri":"https://www.macquarie.com.au/home-loans/offset-home-loan.html#rates-and-fees","overviewUri":"https://www.macquarie.com.au/home-loans/offset-home-loan.html","termsUri":"https://www.macquarie.com.au/assets/bfs/documents/personal-direct/home-loans/MBL-Home-Loans-Terms-and-conditions.pdf"},"applicationUri":"https://www.macquarie.com.au/home-loans/offset-home-loan.html#how-to-apply","brandName":"Macquarie","bundles":[{"name":"Offset Home Loan Package","description":"Our offset home loan package gives you the option to add a credit card with a waived annual fee for the credit card for the life of your home loan. Lending criteria and T&Cs apply. ","additionalInfo":"Add a credit card. Waived annual fee for credit card for the life of your loan. Terms and Conditions apply.","additionalInfoUri":"https://www.macquarie.com.au/home-loans/home-loan-package.html","productIds":["498415VGSGLD","498416VPSPLT"]}],"constraints":[{"constraintType":"MIN_LIMIT","additionalInfo":"Minimum new loan amount $150,000.","additionalInfoUri":"https://www.macquarie.com.au/home-loans/offset-home-loan.html#tab-panels-0-loan-limits","additionalValue":"150000.00"},{"constraintType":"MAX_LIMIT","additionalInfo":"Maximum new loan amount $10,000,000.","additionalInfoUri":"https://www.macquarie.com.au/home-loans/offset-home-loan.html#tab-panels-0-loan-limits","additionalValue":"10000000.00"},{"constraintType":"MAX_LVR",