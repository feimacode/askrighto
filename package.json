{
  "name": "askrighto",
  "version": "0.1.0",
  "private": true,
  "description": "Ask Righto: everyday Aussie decisions, backed by public data. A hosted MCP server.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
